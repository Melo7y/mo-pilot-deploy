COMPOSE_PROJECT_NAME=mopilot

# Domain and source locations
MOPILOT_DOMAIN=mopilot.example.com
MOPILOT_HTTP_PORT=80
MOPILOT_HTTPS_PORT=443
BACKEND_CONTEXT=../backend
FRONTEND_CONTEXT=../frontend
MOPILOT_IMAGE_TAG=20260919-1

# Persistent host paths
MOPILOT_DATA_DIR=/srv/mopilot
LETSENCRYPT_DIR=/etc/letsencrypt

# PostgreSQL. Generate a hexadecimal password; do not use this placeholder.
POSTGRES_DB=mopilot
POSTGRES_USER=mopilot
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32

# Application security
SESSION_COOKIE_NAME=mopilot_session
SESSION_TTL=8h
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=5m

# Initial administrator. The password is intentionally not stored here.
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_TEAM=杭州

# Backup policy
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
TZ=Asia/Shanghai
