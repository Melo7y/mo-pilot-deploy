limit_req_zone $binary_remote_addr zone=mopilot_login_per_ip:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=mopilot_connections_per_ip:10m;

log_format mopilot_login
    '$remote_addr - $time_iso8601 "$request" $status $request_time "$http_user_agent"';

upstream mopilot_api {
    server api:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${MOPILOT_DOMAIN};
    server_tokens off;

    # Preserve the browser's external port when adding a directory trailing slash.
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2050m;
    limit_conn mopilot_connections_per_ip 20;
    limit_req_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:" always;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    error_page 429 = @mopilot_rate_limited;

    location @mopilot_rate_limited {
        internal;
        default_type application/json;
        access_log /var/log/nginx/mopilot-login.log mopilot_login;
        add_header Retry-After 60 always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" always;
        return 429 '{"success":false,"errorCode":"RATE_LIMITED","errorMessage":"登录请求过于频繁，请稍后再试"}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location = /api/v1/auth/login {
        limit_req zone=mopilot_login_per_ip burst=10 nodelay;
        access_log /var/log/nginx/mopilot-login.log mopilot_login;
        proxy_pass http://mopilot_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /api/login/account {
        limit_req zone=mopilot_login_per_ip burst=10 nodelay;
        access_log /var/log/nginx/mopilot-login.log mopilot_login;
        proxy_pass http://mopilot_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /api/ {
        proxy_pass http://mopilot_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ~* \.(?:css|js|mjs|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        try_files $uri =404;
        expires 7d;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
